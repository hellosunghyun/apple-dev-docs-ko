      "id": "seg:paragraph:overview:0008:0001",
      "blockId": "paragraph:overview:0008",
      "type": "sentence",
      "source": "In tvOS, this object provides the display criteria that an [`AVDisplayManager`](https://developer.apple.com/documentation/AVKit/AVDisplayManager) uses to set an appropriate display mode, such as switching to HDR, when presenting a video asset.",
      "normalizedSource": "In tvOS, this object provides the display criteria that an [`AVDisplayManager`](https://developer.apple.com/documentation/AVKit/AVDisplayManager) uses to set an appropriate display mode, such as switching to HDR, when presenting a video asset.",
      "sourceHash": "53029b8f9f21f8ea4876f92e34ba893ae779f6fac5863ae7b2f874646b621081",
      "translatable": true,
      "contextBefore": "Overview",
      "contextAfter": "If your app uses [`AVPlayerViewController`](https://developer.apple.com/documentation/AVKit/AVPlayerViewController) for its player user interface, the system automatically applies the display critera when it presents the asset.",
      "documentTitle": "AVDisplayCriteria",
      "framework": "AVFoundation",
      "ko": "In tvOS에서 이 객체는 `[`AVDisplayManager`](https://developer.apple.com/documentation/AVKit/AVDisplayManager) 가 동영상 자산을 표시할 때 HDR로 전환하는 등 적절한 표시 모드를 설정하는 데 사용하는 display criteria를 제공합니다.",
      "status": "machine_translated",
      "reviewed": false,
      "locked": false,
      "translatedAt": "2026-05-12T15:21:31.687Z",
      "translator": "codex-cli-oauth"
    },
