    {
      "id": "seg:paragraph:discussion:0009:0001",
      "blockId": "paragraph:discussion:0009",
      "type": "sentence",
      "source": "Clients that are filtering media selection options by language should be prepared to handle cases in which this value is `nil`.",
      "normalizedSource": "Clients that are filtering media selection options by language should be prepared to handle cases in which this value is `nil`.",
      "sourceHash": "e1c0bd4f1ec539af614e47fdc48492942d5ed0212599d7f93dde347cc2e2da4f",
      "translatable": true,
      "contextBefore": "This can occur with media formats for which language information is optional, such as HTTP Live Streaming playlists, or that do not accommodate language information in machine-readable form.",
      "contextAfter": "Further, they should be prepared to handle cases in which an `extendedLanguageTag` is present but indicates that the language is “undetermined” (a language value of @“und”, as defined in ISO 639-2).",
      "documentTitle": "extendedLanguageTag",
      "framework": "AVFoundation",
      "ko": "언어 기준으로 미디어 선택 옵션을 필터링하는 클라이언트는 이 값이 `nil`인 경우를 처리할 수 있어야 합니다.",
      "status": "machine_translated",
      "reviewed": false,
      "locked": false,
      "translatedAt": "2026-05-13T00:00:29.138Z",
      "translator": "codex-cli-oauth"
    },
    {
