    {
      "id": "seg:paragraph:discussion:0010:0001",
      "blockId": "paragraph:discussion:0010",
      "type": "sentence",
      "source": "Beginning in iOS 14, users can set a global preference that indicates whether the system displays incoming calls using a banner or a full-screen display style.",
      "normalizedSource": "Beginning in iOS 14, users can set a global preference that indicates whether the system displays incoming calls using a banner or a full-screen display style.",
      "sourceHash": "400977b748d55dfe5fcad9dbce2448c3c47d380c4336d764e486283095879861",
      "translatable": true,
      "contextBefore": "Discussion",
      "contextAfter": "If using the banner style, setting this value to [`true`](https://developer.apple.com/documentation/Swift/true) prevents the system from interrupting the audio session with incoming call notifications, and gives the user an opportunity to accept or decline the call.",
      "documentTitle": "setPrefersNoInterruptionsFromSystemAlerts(:)",
      "framework": "AVFAudio",
      "ko": "iOS 14부터 사용자는 시스템이 수신 전화를 배너 방식 또는 전체 화면 방식으로 표시할지 지정하는 전역 기본 설정을 설정할 수 있습니다.",
      "status": "machine_translated",
      "reviewed": false,
      "locked": false,
      "translatedAt": "2026-05-12T15:21:31.973Z",
      "translator": "codex-cli-oauth"
    },
    {
      "id": "seg:paragraph:discussion:0010:0002",
      "blockId": "paragraph:discussion:0010",
      "type": "sentence",
      "source": "If using the banner style, setting this value to [`true`](https://developer.apple.com/documentation/Swift/true) prevents the system from interrupting the audio session with incoming call notifications, and gives the user an opportunity to accept or decline the call.",
      "normalizedSource": "If using the banner style, setting this value to [`true`](https://developer.apple.com/documentation/Swift/true) prevents the system from interrupting the audio session with incoming call notifications, and gives the user an opportunity to accept or decline the call.",
      "sourceHash": "0ae42b972db158004cfb95f51f88d9aad6428a7f56ac844f02e4ce27cebb2fd9",
      "translatable": true,
      "contextBefore": "Beginning in iOS 14, users can set a global preference that indicates whether the system displays incoming calls using a banner or a full-screen display style.",
      "contextAfter": "The system only interrupts the audio session if the user accepts the call.",
      "documentTitle": "setPrefersNoInterruptionsFromSystemAlerts(:)",
      "framework": "AVFAudio",
      "ko": "배너 방식을 사용할 때 이 값을 [`true`](https://developer.apple.com/documentation/Swift/true)로 설정하면 수신 통화 알림이 오디오 세션을 중단하는 것을 방지하고 사용자가 전화를 수락하거나 거절할 수 있는 기회를 제공합니다.",
      "status": "machine_translated",
      "reviewed": false,
      "locked": false,
      "translatedAt": "2026-05-12T15:21:31.973Z",
      "translator": "codex-cli-oauth"
    },
    {
      "id": "seg:paragraph:discussion:0010:0003",
      "blockId": "paragraph:discussion:0010",
      "type": "sentence",
      "source": "The system only interrupts the audio session if the user accepts the call.",
      "normalizedSource": "The system only interrupts the audio session if the user accepts the call.",
      "sourceHash": "b1c142293f031b3215ec58932373ecc0a8e3302e40b854149826fcf0a5cb22ce",
      "translatable": true,
      "contextBefore": "If using the banner style, setting this value to [`true`](https://developer.apple.com/documentation/Swift/true) prevents the system from interrupting the audio session with incoming call notifications, and gives the user an opportunity to accept or decline the call.",
      "contextAfter": "Enabling this preference can improve the user experience of apps with audio sessions that you don’t want to interrupt, such as those that record audiovisual media or that you use for music performance.",
      "documentTitle": "setPrefersNoInterruptionsFromSystemAlerts(:)",
      "framework": "AVFAudio",
      "ko": "시스템은 사용자가 전화를 수락한 경우에만 오디오 세션을 중단합니다.",
      "status": "machine_translated",
      "reviewed": false,
      "locked": false,
      "translatedAt": "2026-05-12T15:21:31.973Z",
      "translator": "codex-cli-oauth"
    },
    {
      "id": "seg:paragraph:discussion:0011:0001",
      "blockId": "paragraph:discussion:0011",
      "type": "sentence",
      "source": "Enabling this preference can improve the user experience of apps with audio sessions that you don’t want to interrupt, such as those that record audiovisual media or that you use for music performance.",
      "normalizedSource": "Enabling this preference can improve the user experience of apps with audio sessions that you don’t want to interrupt, such as those that record audiovisual media or that you use for music performance.",
      "sourceHash": "a821b47cde8016504d5eb8c179b4eebb9f2a48a8c2bd200ef70598da48049383",
      "translatable": true,
      "contextBefore": "The system only interrupts the audio session if the user accepts the call.",
      "contextAfter": "❗ **Important**: This preference has no effect if the device uses the full-screen display style—the system interrupts the audio session on incoming calls.",
      "documentTitle": "setPrefersNoInterruptionsFromSystemAlerts(:)",
      "framework": "AVFAudio",
      "ko": "이 기본 설정을 활성화하면 영상 및 오디오 미디어 녹음이나 음악 성능용 앱처럼 오디오 세션을 중단하고 싶지 않은 앱의 사용자 경험을 개선할 수 있습니다.",
      "status": "machine_translated",
      "reviewed": false,
