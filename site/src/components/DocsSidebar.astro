---
interface NavItem {
  sourcePath: string;
  slug: string;
  title: string;
  framework: string;
}

interface FrameworkItem {
  name: string;
  count?: number;
}

interface HeadingItem {
  slug: string;
  text: string;
}

interface Props {
  items: NavItem[];
  frameworks?: FrameworkItem[];
  current?: string;
  mode?: "technologies" | "framework";
  currentFramework?: string;
  headings?: HeadingItem[];
}

const {
  items,
  frameworks = [],
  current = "",
  mode = "technologies",
  currentFramework = "",
  headings = []
} = Astro.props;
const base = import.meta.env.BASE_URL;
const href = (path: string) => `${base}${path.replace(/^\//, "")}`;
const currentSlug = current.toLowerCase();
const officialDisplayNames: Record<string, string> = {
  AccessoryLiveActivities: "Accessory Live Activities",
  AccessoryNotifications: "Accessory Notifications",
  AccessoryTransportExtension: "Accessory Transport Extension",
  AccountDataTransfer: "Account Data Transfer",
  AccountOrganizationalDataSharing: "Account & Organizational Data Sharing",
  AddressBook: "Address Book",
  AddressBookUI: "Address Book UI",
  AdvancedCommerceAPI: "Advanced Commerce API"
};
const displayName = (value: string) => officialDisplayNames[value] ?? value;
const frameworkName = currentFramework || items.find((item) => item.slug.toLowerCase() === currentSlug)?.framework || "Documentation";
const frameworkDocs = items
  .filter((item) => item.framework === frameworkName)
  .sort((a, b) => a.title.localeCompare(b.title));
const currentDoc = items.find((item) => item.slug.toLowerCase() === currentSlug);
const currentDocRows = currentDoc ? [currentDoc, ...frameworkDocs.filter((item) => item.slug !== currentDoc.slug)] : frameworkDocs;
const localFrameworkCounts = new Map<string, number>();
const firstDocByFramework = new Map<string, NavItem>();
for (const item of items) {
  localFrameworkCounts.set(item.framework, (localFrameworkCounts.get(item.framework) ?? 0) + 1);
  if (!firstDocByFramework.has(item.framework)) firstDocByFramework.set(item.framework, item);
}
const technologyNames = frameworks.length
  ? frameworks.map((framework) => framework.name)
  : Array.from(localFrameworkCounts.keys());
const technologyRows = Array.from(new Set(technologyNames))
  .map((name) => ({
    title: name,
    count: localFrameworkCounts.get(name) ?? 0,
    totalCount: frameworks.find((framework) => framework.name === name)?.count,
    firstDoc: firstDocByFramework.get(name)
  }))
  .filter((row) => row.firstDoc)
  .sort((a, b) => displayName(a.title).localeCompare(displayName(b.title)));
const hiddenHeadingText = new Set(["Declaration", "Topics", "Relationships", "Conforms To"]);
const visibleHeadings = headings
  .filter((heading) => heading.slug && heading.text && heading.text !== currentDoc?.title && !hiddenHeadingText.has(heading.text))
  .slice(0, 16);
---

<aside class="documentation-navigator" data-navigator data-mode={mode}>
  <div class="navigator-title">
    <span class="navigator-icon" aria-hidden="true">
      <svg viewBox="0 0 20 20">
        <path d="M3.2 3.5h5.3v13H3.2a.9.9 0 0 1-.9-.9V4.4a.9.9 0 0 1 .9-.9Zm8.3 0h5.3a.9.9 0 0 1 .9.9v11.2a.9.9 0 0 1-.9.9h-5.3v-13Zm-1.5 0h1.5v13H10v-13Z" fill="currentColor" />
      </svg>
    </span>
    <h2>Documentation</h2>
  </div>
  <div class="navigator-scroll">
    {
      mode === "framework" ? (
        <>
          <a class="navigator-back" href={href("docs/")}>All Technologies</a>
          <h3 class="navigator-framework-title">{frameworkName}</h3>
          <section class="navigator-group">
            <h4 class="navigator-group-title">Topics</h4>
            <ul class="navigator-list">
              {currentDocRows.slice(0, 120).map((doc) => (
                <li data-filter-value={`${frameworkName} ${doc.title} ${doc.sourcePath}`.toLowerCase()}>
                  <a class="navigator-link" href={href(`docs/${doc.slug}/`)} aria-current={currentSlug === doc.slug.toLowerCase() ? "page" : undefined}>
                    <span class="navigator-doc-icon" aria-hidden="true">C</span>
                  <span>{doc.title}</span>
                  </a>
                  {currentSlug === doc.slug.toLowerCase() && visibleHeadings.length ? (
                    <ul class="navigator-sublist">
                      {visibleHeadings.map((heading) => (
                        <li><a href={`#${heading.slug}`}>{heading.text}</a></li>
                      ))}
                    </ul>
                  ) : null}
                </li>
              ))}
            </ul>
          </section>
        </>
      ) : (
        <ul class="navigator-list navigator-list-flat">
          {technologyRows.slice(0, 260).map((row) => (
            <li data-filter-value={`${row.title} ${displayName(row.title)}`.toLowerCase()}>
              <a class="navigator-link" href={href(`docs/${row.firstDoc!.slug}/`)}>
                <span class="navigator-stack" aria-hidden="true"><span></span></span>
                <span class="navigator-link-label">
                  <span>{displayName(row.title)}</span>
                  <small>{row.count}개 번역</small>
                </span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
  <div class="navigator-filter">
    <label class="navigator-filter-field">
      <svg viewBox="0 0 20 20" aria-hidden="true">
        <path d="M3 5.5h14V7H3V5.5Zm3 4h8v1.5H6V9.5Zm3 4h2v1.5H9v-1.5Z" fill="currentColor" />
      </svg>
      <span class="sr-only">문서 필터</span>
      <input type="search" placeholder="Filter" data-navigator-filter />
    </label>
    <span class="shortcut-key" aria-hidden="true">/</span>
  </div>
</aside>

<script>
  // @ts-nocheck
  for (const navigator of document.querySelectorAll("[data-navigator]")) {
    const input = navigator.querySelector("[data-navigator-filter]");
    const rows = Array.from(navigator.querySelectorAll("[data-filter-value]"));
    input?.addEventListener("input", () => {
      const query = input.value.trim().toLowerCase();
      for (const row of rows) {
        row.hidden = query ? !row.dataset.filterValue.includes(query) : false;
      }
    });
    document.addEventListener("keydown", (event) => {
      if (event.key !== "/" || event.metaKey || event.ctrlKey || event.altKey) return;
      const target = event.target;
      if (target?.matches?.("input, textarea, select")) return;
      event.preventDefault();
      input?.focus();
    });
  }
</script>
