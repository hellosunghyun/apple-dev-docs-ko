---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DocsSidebar from "../../components/DocsSidebar.astro";
import frameworksData from "../../data/frameworks.json";
import nav from "../../data/navigation.json";

type NavEntry = (typeof nav)[number];

const grouped = new Map<string, NavEntry[]>();
const base = import.meta.env.BASE_URL;
const href = (path = "") => `${base}${path.replace(/^\//, "")}`;
for (const item of nav) {
  const list = grouped.get(item.framework) ?? [];
  list.push(item);
  grouped.set(item.framework, list);
}
const frameworkRows = Array.from(grouped.entries())
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([framework, docs]) => {
    docs.sort((a: NavEntry, b: NavEntry) => a.title.localeCompare(b.title));
    const summary = frameworksData.find((item) => item.name === framework);
    return { framework, docs, totalCount: summary?.count };
  });
---

<BaseLayout title="문서 - Apple Dev Docs KO">
  <main class="documentation-frame">
    <DocsSidebar items={nav} frameworks={frameworksData} />
    <section class="list-layout documentation-directory">
      <p class="directory-eyebrow">Documentation</p>
      <h1>기술 문서</h1>
      <p>왼쪽 navigator에서 기술을 선택하거나 아래 목록에서 번역된 문서를 바로 엽니다.</p>
      <ul class="technology-directory" aria-label="번역된 기술 문서">
        {
          frameworkRows.map(({ framework, docs, totalCount }) => (
            <li>
              <a href={href(`docs/${docs[0]?.slug ?? ""}/`)}>
                <span>{framework}</span>
                <small>{docs.length}개 번역{totalCount && totalCount !== docs.length ? ` / 원문 ${totalCount}개` : ""}</small>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
</BaseLayout>
