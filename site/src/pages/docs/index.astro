---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DocsSidebar from "../../components/DocsSidebar.astro";
import nav from "../../data/navigation.json";

const grouped = new Map();
const base = import.meta.env.BASE_URL;
const href = (path = "") => `${base}${path.replace(/^\//, "")}`;
for (const item of nav) {
  const list = grouped.get(item.framework) ?? [];
  list.push(item);
  grouped.set(item.framework, list);
}
---

<BaseLayout title="문서 - Apple Dev Docs KO">
  <main class="documentation-frame">
    <DocsSidebar items={nav} />
    <section class="list-layout">
      <h1>Documentation</h1>
      <p>비공식 한국어 번역 문서 인덱스입니다. 왼쪽 navigator 또는 framework 카드를 통해 문서를 열 수 있습니다.</p>
      <ul class="framework-list">
        {
          Array.from(grouped.entries()).sort(([a], [b]) => a.localeCompare(b)).map(([framework, docs]) => (
            <li class="framework-item">
              <strong>{framework}</strong>
              <p>{docs.length}개 문서</p>
              <a class="button compact" href={href(`docs/${docs[0]?.slug ?? ""}/`)}>Open</a>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
</BaseLayout>
