---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import DocsSidebar from "../../components/DocsSidebar.astro";
import SourceViewControls from "../../components/SourceViewControls.astro";
import nav from "../../data/navigation.json";

export async function getStaticPaths() {
  const docs = await getCollection("docs");
  return docs.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const sourcePath = entry.data.source_path ?? `${entry.slug}.md`;
const currentNav = nav.find((item) => item.slug === entry.slug);
const base = import.meta.env.BASE_URL;
const href = (path = "") => `${base}${path.replace(/^\//, "")}`;
const sourceMapUrl = href(`source-maps/${entry.slug}.json`);
const editBase = `https://github.com/OWNER/apple-dev-docs-ko-automation/edit/main/overrides/ko/${sourcePath.replace(/\.md$/i, ".yaml")}`;
---

<BaseLayout title={`${entry.data.source_path ?? entry.slug} - Apple Dev Docs KO`}>
  <main class="docs-grid">
    <DocsSidebar items={nav} current={entry.slug} />
    <div class="docs-content-frame">
      <article class="doc-main">
        <div class="doc-body-grid">
          <div class="doc-article">
            <nav class="breadcrumb" aria-label="문서 경로">
              <a href={href("docs/")}>Documentation</a>
              <span>/</span>
              <span>{currentNav?.framework ?? "Framework"}</span>
            </nav>
            <p class="badge">비공식 한국어 번역</p>
            <SourceViewControls sourceMapUrl={sourceMapUrl} editBase={editBase} />
            <div class="doc-content">
              <Content />
            </div>
          </div>
          <aside class="toc">
            <h2>On this page</h2>
            <ul class="sidebar-list">
              {headings.map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}
            </ul>
            <p><a href={entry.data.official_url ?? "#"}>View official documentation</a></p>
          </aside>
        </div>
      </article>
    </div>
  </main>
</BaseLayout>
