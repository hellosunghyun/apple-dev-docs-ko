---
import BaseLayout from "../layouts/BaseLayout.astro";
import DocsSidebar from "../components/DocsSidebar.astro";
import frameworksData from "../data/frameworks.json";
import nav from "../data/navigation.json";
const searchIndexUrl = `${import.meta.env.BASE_URL}search/index.json`;
---

<BaseLayout title="검색 - Apple Dev Docs KO">
  <main class="documentation-frame" data-search-index={searchIndexUrl} data-base-url={import.meta.env.BASE_URL}>
    <DocsSidebar items={nav} frameworks={frameworksData} />
    <section class="search-layout">
      <h1>Search Documentation</h1>
      <p>문서 제목, framework, symbol, source path를 검색합니다.</p>
      <input class="search-input" type="search" placeholder="Search documentation" data-search-input />
      <ul class="result-list" data-search-results></ul>
    </section>
  </main>
  <script>
    // @ts-nocheck
    const input = document.querySelector("[data-search-input]");
    const results = document.querySelector("[data-search-results]");
    let items = [];
    const root = document.querySelector("[data-search-index]");
    const searchIndexUrl = root?.getAttribute("data-search-index") || "/search/index.json";
    const baseUrl = root?.getAttribute("data-base-url") || "/";
    fetch(searchIndexUrl)
      .then((response) => response.ok ? response.json() : { items: [] })
      .then((data) => {
        items = data.items ?? [];
        render(items.slice(0, 20));
      });
    input?.addEventListener("input", () => {
      const query = input.value.trim().toLowerCase();
      const found = query ? items.filter((item) => item.haystack.includes(query)).slice(0, 50) : items.slice(0, 20);
      render(found);
    });
    function render(found) {
      results.innerHTML = "";
      for (const item of found) {
        const li = document.createElement("li");
        li.className = "result-item";
        li.innerHTML = `<strong><a href="${baseUrl}docs/${item.slug}/">${item.title}</a></strong><br><span>${item.framework} · ${item.sourcePath}</span>`;
        results.append(li);
      }
      if (!found.length) {
        const li = document.createElement("li");
        li.className = "result-item";
        li.textContent = "검색 결과가 없습니다.";
        results.append(li);
      }
    }
  </script>
</BaseLayout>
