---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProgressSummary from "../components/ProgressSummary.astro";
import nav from "../data/navigation.json";
import status from "../data/status.json";

const totals = status.totals ?? { files: 0, translatedFiles: 0, failedSegments: 0, needsReview: 0, progress: 0 };
const frameworks = Array.from(new Set(nav.map((item) => item.framework))).slice(0, 12);
const base = import.meta.env.BASE_URL;
const href = (path = "") => `${base}${path.replace(/^\//, "")}`;
---

<BaseLayout title="Apple Dev Docs KO">
  <main class="site-shell">
    <section class="hero">
      <div>
        <h1>Apple Dev Docs KO</h1>
        <p>
          Apple Developer Documentation의 비공식 한국어 번역을 파일 기반 자동화로 유지합니다.
          문장 단위 원문 확인, 사람 수정 override, upstream diff 재번역, GitHub Pages 배포를 한 흐름으로 제공합니다.
        </p>
        <div class="actions">
          <a class="button primary" href={href("docs/")}>문서 보기</a>
          <a class="button" href={href("search/")}>검색하기</a>
          <a class="button" href={href("contribute/")}>번역 수정하기</a>
        </div>
      </div>
      <ProgressSummary {...totals} />
    </section>
    <section class="panel" style="padding:1rem">
      <h2>문서 그룹</h2>
      <ul class="framework-list">
        {frameworks.map((framework) => <li class="framework-item"><strong>{framework}</strong></li>)}
      </ul>
    </section>
  </main>
</BaseLayout>
