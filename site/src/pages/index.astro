---
import BaseLayout from "../layouts/BaseLayout.astro";
import DocsSidebar from "../components/DocsSidebar.astro";
import frameworksData from "../data/frameworks.json";
import nav from "../data/navigation.json";

---

<BaseLayout title="Apple Dev Docs KO">
  <main class="documentation-frame">
    <DocsSidebar items={nav} frameworks={frameworksData} />
    <div class="documentation-home">
      <section class="hero">
        <div class="hero-inner">
          <div class="hero-figure" aria-hidden="true">
            <span class="hero-rocket"></span>
          </div>
          <h1>Apple Developer Documentation</h1>
          <p>
            Browse the latest sample code, articles, tutorials, and API reference.
          </p>
        </div>
      </section>
      <section class="official-feature-preview" aria-label="추천 콘텐츠">
        <h2>Dive into WWDC25</h2>
        <div class="preview-card-row" aria-hidden="true">
          <div></div>
          <div></div>
          <div></div>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>
