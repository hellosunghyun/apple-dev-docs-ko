---
import BaseLayout from "../layouts/BaseLayout.astro";
const base = import.meta.env.BASE_URL;
const href = (path = "") => `${base}${path.replace(/^\//, "")}`;
const basePath = base.endsWith("/") ? base : `${base}/`;
---

<BaseLayout title="페이지 없음 - Apple Dev Docs KO">
  <main class="site-shell list-layout">
    <h1>페이지를 찾을 수 없습니다</h1>
    <p>문서 인덱스나 검색에서 다시 찾아보세요.</p>
    <div class="actions">
      <a class="button primary" href={href("docs/")}>문서 보기</a>
      <a class="button" href={href("search/")}>검색하기</a>
    </div>
  </main>
  <script is:inline define:vars={{ basePath }}>
    (() => {
      const docsPrefix = `${basePath}docs/`;
      const currentPath = window.location.pathname;
      if (!currentPath.startsWith(docsPrefix)) return;

      const requestedSlug = currentPath.slice(docsPrefix.length).replace(/\/$/, "");
      const normalizedSlug = requestedSlug.toLowerCase();
      const loadNavigation = async () => {
        for (const url of [`${basePath}navigation.json`, "/navigation.json"]) {
          const response = await fetch(url);
          if (response.ok) return response.json();
        }
        return [];
      };

      loadNavigation()
        .then((items) => {
          const match = items.find((item) => item.slug.toLowerCase() === normalizedSlug);
          if (!match || match.slug === requestedSlug) return;
          window.location.replace(`${basePath}docs/${match.slug}/${window.location.search}${window.location.hash}`);
        })
        .catch(() => {});
    })();
  </script>
</BaseLayout>
