    {
      "id": "seg:paragraph:discussion:0008:0001",
      "source": "The preferred volume for an audio track is typically, but not always, `1.0`.",
      "ko": "오디오 트랙의 선호 볼륨은 일반적으로 `1.0`이지만 항상 그런 것은 아닙니다.",
      "sourceHash": "ea6ac5c1194d868ab4a5768cbc300d33c4c4b438e6df8e81ebd3067b02d3058f",
      "status": "machine_translated"
    },
    {
      "id": "seg:paragraph:discussion:0008:0002",
      "source": "For non-audible tracks, the value is `0.0`.",
      "ko": "비가청 트랙의 경우 값은 `0.0`입니다.",
      "sourceHash": "506ea19dd2cb053ca8be24400a49f014208950d9f6d965be9c9fc2e048f2c677",
