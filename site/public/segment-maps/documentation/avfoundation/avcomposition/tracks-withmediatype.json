    {
      "id": "seg:paragraph:discussion:0010:0001",
      "source": "Apple discourages using this method in iOS 15, tvOS 15, macOS 12, and watchOS 8 or later.",
      "ko": "Apple은 iOS 15, tvOS 15, macOS 12 및 watchOS 8 이상에서 이 메서드 사용을 권장하지 않습니다.",
      "sourceHash": "a43b5778b9e46b3af59b8b30849435653fc2f65a038607993cbafc4f92c2523c",
      "status": "machine_translated"
    },
    {
      "id": "seg:paragraph:discussion:0010:0002",
      "source": "Load tracks asynchronously using [`loadTracks(withMediaType:completionHandler:)`](avcomposition/loadtracks(withmediatype:completionhandler:).md) instead.",
