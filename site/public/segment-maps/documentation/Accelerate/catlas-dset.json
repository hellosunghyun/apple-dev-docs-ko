      "sourceHash": "e68b36b17cbd990802f57741cb75cf3a73fa66a61999b0cd70e3cf7d26cfb25f",
      "status": "preserved"
    },
    {
      "id": "seg:list:parameters:0010:0001",
      "source": "`N`: The number of elements in the vector.",
      "ko": "`N`: 벡터의 요소 수입니다.",
      "sourceHash": "53731ada5948eac3b1de38684c5644a9002dc12cf0f3f166bad45e003174b295",
      "status": "machine_translated"
    },
    {
      "id": "seg:list:parameters:0010:0002",
