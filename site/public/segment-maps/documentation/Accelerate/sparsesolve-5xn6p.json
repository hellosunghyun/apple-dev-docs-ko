    {
      "id": "seg:paragraph:discussion:0008:0001",
      "source": "If the factorization is `A=QR` and the system is underdetermined, the solution of minimum norm `|| x ||_2` is returned.",
      "ko": "If the factorization is `A=QR` and the system is underdetermined, the solution of minimum norm `|| x ||_2` is returned.",
      "sourceHash": "a3fa78547382dc470567c713f48d7f7f273bbd562f009eae889698bafce610e7",
      "status": "failed"
    },
    {
      "id": "seg:paragraph:discussion:0008:0002",
      "source": "If the factorization is `A=QR` and the system is overdetermined, the least squares solution `arg min_x || Ax - b ||_2` is returned.",
      "ko": "If the factorization is `A=QR` and the system is overdetermined, the least squares solution `arg min_x || Ax - b ||_2` is returned.",
      "sourceHash": "9972e3a1bc4ab174eaa6977bcb4b69dd41d887970648680ce76c6e8be8ce9d3c",
      "status": "failed"
    },
    {
      "id": "seg:paragraph:discussion:0008:0003",
      "source": "In the case of a factorization of `type=SparseCholeskyAtA`, the factorization is in fact of `A^T A`, so the solution returned is for the system `A^TAx=b`.",
      "ko": "In the case of a factorization of `type=SparseCholeskyAtA`, the factorization is in fact of `A^T A`, so the solution returned is for the system `A^TAx=b`.",
      "sourceHash": "875ba58a588d935d3833e63e858b576ef37a87f75f57ef117e9201c3a6af4f9c",
      "status": "failed"
    },
