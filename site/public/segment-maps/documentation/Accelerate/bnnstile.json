    {
      "id": "seg:code:declaration:0006:0001",
      "source": "```swift\nfunc BNNSTile(_ input: UnsafePointer<BNNSNDArrayDescriptor>, _ output: UnsafeMutablePointer<BNNSNDArrayDescriptor>, _ filter_params: UnsafePointer<BNNSFilterParameters>?) -> Int32\n```",
      "ko": "```swift\nfunc BNNSTile(_ input: UnsafePointer<BNNSNDArrayDescriptor>, _ output: UnsafeMutablePointer<BNNSNDArrayDescriptor>, _ filter_params: UnsafePointer<BNNSFilterParameters>?) -> Int32\n```",
      "sourceHash": "c28d098c14773ba44aec1ecc32b68e309ed133d3d8c10b83a97a75696d4d2115",
      "status": "preserved"
    },
    {
      "id": "seg:heading:discussion:0007:0001",
