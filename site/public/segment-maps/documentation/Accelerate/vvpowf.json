    {
      "id": "seg:code:declaration:0006:0001",
      "source": "```swift\nfunc vvpowf(_: UnsafeMutablePointer<Float>, _: UnsafePointer<Float>, _: UnsafePointer<Float>, _: UnsafePointer<Int32>)\n```",
      "ko": "```swift\nfunc vvpowf(_: UnsafeMutablePointer<Float>, _: UnsafePointer<Float>, _: UnsafePointer<Float>, _: UnsafePointer<Int32>)\n```",
      "sourceHash": "70c6525b1c047a5762a660ff70ccf945e1764548ea3135b1e3720f3feba43e6c",
      "status": "preserved"
    },
    {
