      "status": "preserved"
    },
    {
      "id": "seg:paragraph:vvpowf:0002:0001",
      "source": "Raises each element in an array to the power of the corresponding element in a second array of single-precision values.",
      "ko": "단일 정밀도 값 배열의 두 번째 배열 요소만큼 배열의 각 요소를 거듭제곱합니다.",
      "sourceHash": "48cbc654f7b7aaed603fbccd394a01c9e0c441f7b6a7445864abcd0e309c7cec",
      "status": "machine_translated"
    },
    {
