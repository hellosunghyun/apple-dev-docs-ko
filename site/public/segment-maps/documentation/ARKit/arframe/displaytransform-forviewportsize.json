    {
      "id": "seg:paragraph:displaytransformforviewportsize:0002:0001",
      "source": "Returns an affine transform for converting between normalized image coordinates and a coordinate space appropriate for rendering the camera image onscreen.",
      "ko": "캡처된 이미지의 정규화된 좌표를 화면에서 카메라 이미지를 렌더링하기에 적절한 좌표 공간으로 변환하는 아핀 변환을 반환합니다.",
      "sourceHash": "fa7abcf37671ae5d73af039041297beb576cb2707bb39db0e77c3e3dd4ed5f77",
      "status": "machine_translated"
    },
