    {
      "id": "seg:paragraph:discussion:0008:0001",
      "source": "If the value is `true`, a player view tries to find objects, text, and people when you pause media playback.",
      "ko": "This property is currently supported only with a [`controlsStyle`](avplayerview/controlsstyle.md) of [`AVPlayerViewControlsStyle.floating`](avplayerviewcontrolsstyle/floating.md) or [`AVPlayerViewControlsStyle.inline`](avplayerviewcontrolsstyle/inline.md).",
      "sourceHash": "bacf46f0195732c97aedcd2ed17ca0aed4feb67e48240e6247dda3e24ca4e6b0",
      "status": "machine_translated"
    },
    {
      "id": "seg:paragraph:discussion:0008:0002",
      "source": "If it finds an object, the user is able to interact with it using a long press to present a context menu.",
      "ko": "개체를 찾으면 사용자는 길게 눌러 컨텍스트 메뉴를 표시하고 해당 개체와 상호작용할 수 있습니다.",
      "sourceHash": "cb1c014c1dcdf3c2366a4a4d9e33b2f62f159de4517871be2af3a85907822cc4",
      "status": "machine_translated"
    },
    {
      "id": "seg:paragraph:discussion:0009:0001",
      "source": "The default value is `true`.",
      "ko": "The default value is `false`.",
      "sourceHash": "590bbc8981758a3b5401d52152d7fdbf26e4e02f83d8341ad184ae1ad88909bc",
      "status": "machine_translated"
