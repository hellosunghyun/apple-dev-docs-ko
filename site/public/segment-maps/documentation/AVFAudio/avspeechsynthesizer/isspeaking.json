    {
      "id": "seg:paragraph:isspeaking:0002:0001",
      "source": "A Boolean value that indicates whether the speech synthesizer is speaking or is in a paused state and has utterances to speak.",
      "ko": "음성 합성기가 발화 중이거나 일시 중지 상태에서 발화 항목을 보유하고 있는지 여부를 나타내는 불리언 값입니다.",
      "sourceHash": "7c4126fecdacfdd88124b5cb99049786f541b9d97603fb06ec9d14df73e3ac1d",
      "status": "machine_translated"
    },
