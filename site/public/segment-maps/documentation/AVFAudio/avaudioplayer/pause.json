    {
      "id": "seg:paragraph:discussion:0008:0001",
      "source": "Unlike calling [`stop()`](avaudioplayer/stop().md), pausing playback doesn’t deallocate hardware resources.",
      "ko": "This property is [`nil`](https://developer.apple.com/documentation/ObjectiveC/nil-227m0) if you don’t create the player with a URL.",
      "sourceHash": "51aebee5a9d0f31f4d8116dea479736a9189f3c257b94c46b47f2414d812366e",
      "status": "machine_translated"
    },
    {
      "id": "seg:paragraph:discussion:0008:0002",
      "source": "It leaves the audio ready to resume playback from where it stops.",
      "ko": "오디오는 중단된 지점에서 재생을 다시 시작할 수 있도록 준비 상태로 유지됩니다.",
      "sourceHash": "43e9b3d2a3c57480fc2ccfed4e9f5504dde8a264e2a2710220fca78271cd9f35",
      "status": "machine_translated"
    },
