    {
      "id": "seg:paragraph:overview:0010:0001",
      "source": "These constants appear as possible values for the [`AVAudioSessionRouteChangeReasonKey`](avaudiosessionroutechangereasonkey.md) key in the `userInfo` dictionary in a [`routeChangeNotification`](avaudiosession/routechangenotification.md) notification.",
      "ko": "이 상수는 [`routeChangeNotification`](avaudiosession/routechangenotification.md) 알림의 `userInfo` 딕셔너리 내 [`AVAudioSessionRouteChangeReasonKey`](avaudiosessionroutechangereasonkey.md) 키에서 가능한 값으로 표시됩니다.",
      "sourceHash": "ad207cf2e3ec0716f2fa58fc66eda39b36dd03d29116a94854870a1257c18346",
      "status": "machine_translated"
    },
