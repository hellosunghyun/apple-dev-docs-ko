    {
      "id": "seg:paragraph:discussion:0008:0001",
      "source": "You specify the feedback as a percentage.",
      "ko": "피드백은 백분율로 지정합니다.",
      "sourceHash": "38b274c959339824c167f187b80335c0ad211e586e6afa29d212794a57efb729",
      "status": "machine_translated"
    },
    {
      "id": "seg:paragraph:discussion:0008:0002",
      "source": "The default value is `50%`.",
      "ko": "기본값은 `50%`입니다.",
      "sourceHash": "cc8ccbe94f3f598d47ff51ad3150b3d38df12d3c06d516a7cfe3829e6b7111b3",
      "status": "machine_translated"
    },
    {
      "id": "seg:paragraph:discussion:0008:0003",
      "source": "The valid range of values is `-100%` to `100%`.",
      "ko": "유효 값 범위는 `-100%`에서 `100%`입니다.",
      "sourceHash": "464a7ed97b49060b71cb00789d55576151ec238de592ae509c5569d1cb82e722",
      "status": "machine_translated"
    },
