      "sourceHash": "9be7afa78beb048df65e0e45022701f51831a960b225aebb1a5edef3b8796a00",
      "status": "preserved"
    },
    {
      "id": "seg:paragraph:capturescursor:0002:0001",
      "source": "A Boolean value that specifies whether the mouse cursor appears in the captured output.",
      "ko": "캡처된 출력에 마우스 커서가 표시되는지 지정하는 Boolean 값입니다.",
      "sourceHash": "be068725bb34846b61fd23eb2e5dab5e7954012332e3e24c8add42bff7ea7707",
      "status": "machine_translated"
    },
    {
      "id": "seg:paragraph:capturescursor:0003:0001",
      "source": "**Availability**:",
      "ko": "**Availability**:",
      "sourceHash": "c54a2ed36492f9321cad7af43ab3edbbabcab53520c009f69016847ac8028dc3",
      "status": "preserved"
    },
    {
      "id": "seg:list:capturescursor:0004:0001",
      "source": "macOS 10.8+",
      "ko": "macOS 10.8+",
      "sourceHash": "f3a9e14ee293c884d2cb370f5f755069c45e9b1b88587a86f92a22178822639b",
      "status": "preserved"
    },
    {
