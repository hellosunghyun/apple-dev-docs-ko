    {
      "id": "seg:paragraph:discussion:0008:0001",
      "source": "HDR video contains extended dynamic range that requires explicit support when compositing.",
      "ko": "HDR 비디오에는 합성 시 명시적인 지원이 필요한 확장된 동적 범위가 포함됩니다.",
      "sourceHash": "2a2ef09232b5d9d455264329e2cc42858f4ae76b7199b20c78f2b636c199b57f",
      "status": "machine_translated"
    },
    {
      "id": "seg:paragraph:discussion:0008:0002",
      "source": "The system infers this characteristic from the format description of the associated track.",
      "ko": "시스템은 관련 트랙의 형식 설명을 기반으로 이 특성을 추론합니다.",
      "sourceHash": "e37a520198b1b3f57d4429595d811e13f14aff8a95f94264da1846cb588a5a6e",
      "status": "machine_translated"
    },
    {
      "id": "seg:paragraph:discussion:0009:0001",
      "source": "The value of this characteristic is `public.contains-hdr-video`.",
      "ko": "이 특성의 값은 `public.contains-hdr-video`입니다.",
      "sourceHash": "40f297ed2a9aedaf3915ddfd2aaaa97b0d1d54125b2690a7bc4f72b7bb4016b7",
      "status": "machine_translated"
    },
