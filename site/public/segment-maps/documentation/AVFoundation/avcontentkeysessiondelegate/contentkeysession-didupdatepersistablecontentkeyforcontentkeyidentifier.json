    {
      "id": "seg:paragraph:discussion:0008:0001",
      "source": "If the content key session provides updated persistable content key data, previous key data is no longer valid and cannot be used to answer future loading requests.",
      "ko": "The value of this UTI is `com.apple.m4a-audio`.",
      "sourceHash": "be5cce5e9663188ea4a382a85595c7eb5563109ea61e1cd91335f7d675c63cae",
      "status": "machine_translated"
    },
