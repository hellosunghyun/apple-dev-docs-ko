    },
    {
      "id": "seg:paragraph:see-also:0013:0001",
      "source": "Indicates that the AVExternalSyncDevice was calibrated to follow the external sync, but the sync signal has been lost.",
      "ko": "AVExternalSyncDevice가 외부 동기화에 맞춰 보정되었지만 동기화 신호가 손실되었음을 나타냅니다.",
      "sourceHash": "0b3de8d0f0c2a255ce5f5d6f2a8ec5dae7cdfd39538050825c002d2fb1faaa96",
      "status": "machine_translated"
    },
    {
      "id": "seg:paragraph:see-also:0013:0002",
      "source": "The camera will continue to match the last signal it received, but sync is not guaranteed.",
      "ko": "카메라는 마지막으로 수신한 신호를 계속 추적하지만 동기화가 보장되지 않습니다.",
      "sourceHash": "34bfd32be9f91405969ba93d29452bc7d636bde62e9f239da130b780bfb24002",
      "status": "machine_translated"
    },
