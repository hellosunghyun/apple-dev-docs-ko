    {
      "id": "seg:paragraph:discussion:0010:0001",
      "source": "Place composited video frames in `videoLayer` and render `animationLayer` to produce the final frame.",
      "ko": "합성된 비디오 프레임을 `videoLayer`에 배치하고 `animationLayer`를 렌더링하여 최종 프레임을 생성합니다.",
      "sourceHash": "144bb0eda0860c0d7b585de9ceee3dc9baf37011d390db8e7c9df115e2598418",
      "status": "machine_translated"
    },
    {
      "id": "seg:paragraph:discussion:0011:0001",
      "source": "The `videoLayer` should be in the `animationLayer` sublayer tree.",
      "ko": "`videoLayer`는 `animationLayer` 하위 레이어 트리에 있어야 합니다.",
      "sourceHash": "343d6638ab9553d26808bc55931fec48413c78b45028712fdc5f46b0b6fa4fee",
      "status": "machine_translated"
    },
    {
      "id": "seg:paragraph:discussion:0011:0002",
      "source": "The `animationLayer` should not come from, or be added to, another layer tree.",
      "ko": "`animationLayer`는 다른 레이어 트리에서 가져오거나 다른 레이어 트리에 추가된 상태여서는 안 됩니다.",
      "sourceHash": "0179931649c7e8d7b1e232ef1352b4d84868f17bcfa4f8b892150345acda6cd4",
      "status": "machine_translated"
    },
