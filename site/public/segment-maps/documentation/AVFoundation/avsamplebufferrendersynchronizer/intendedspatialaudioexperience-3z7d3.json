    {
      "id": "seg:paragraph:discussion:0008:0001",
      "source": "The value applies to all [`AVSampleBufferAudioRenderer`](avsamplebufferaudiorenderer.md) objects within this synchronizer.",
      "ko": "Use this I/O type if your app doesn’t use [`AVCaptureSession`](https://developer.apple.com/documentation/AVFoundation/AVCaptureSession), or doesn’t have any specific requirements for aggregating input and output audio in the same realtime I/O callback.",
      "sourceHash": "391619fdcb42983bfdf8da0b97609569743abbfdf4f263bc1948c533f27c8dda",
      "status": "machine_translated"
    },
    {
      "id": "seg:paragraph:discussion:0009:0001",
      "source": "If unspecified, the property value defaults to [`CAAutomaticSpatialAudio`](https://developer.apple.com/documentation/AudioToolbox/CAAutomaticSpatialAudio).",
      "ko": "앱이 캡처 세션을 사용하는 경우, 이 값을 지정하면 이미 실행 중인 출력 오디오에 글리치 없이 세션이 녹화를 시작할 수 있습니다.",
      "sourceHash": "4f88d25240ddc2a593502707b9425f0c969a1299571e3e73f563806ab40058ca",
      "status": "machine_translated"
