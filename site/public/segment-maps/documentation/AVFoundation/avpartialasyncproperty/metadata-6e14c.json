    {
      "id": "seg:paragraph:discussion:0008:0001",
      "source": "Use the [`load(_:isolation:)`](avasynchronouskeyvalueloading/load(_:isolation:).md) method to retrieve the property value.",
      "ko": "This property provides access to an instance of [`AVAssetCache`](avassetcache.md) to use for inspection of locally cached media data.",
      "sourceHash": "b67a32a8e8226c9f72a78c9fc03ed0fdd4726d97e35b02242b79574b9c97fc55",
      "status": "machine_translated"
    },
    {
      "id": "seg:paragraph:discussion:0009:0001",
      "source": "You can filter the array of metadata items according to language using the [`metadataItems(from:filteredAndSortedAccordingToPreferredLanguages:)`](avmetadataitem/metadataitems(from:filteredandsortedaccordingtopreferredlanguages:).md) method.",
      "ko": "[`metadataItems(from:filteredAndSortedAccordingToPreferredLanguages:)`](avmetadataitem/metadataitems(from:filteredandsortedaccordingtopreferredlanguages:).md) 메서드를 사용하면 언어에 따라 메타데이터 항목 배열을 필터링할 수 있습니다.",
      "sourceHash": "a4ce93e4a57b6129bd8b721a7412d4a97002ad54ea12e46b0becd8303322bf2a",
      "status": "machine_translated"
    },
    {
      "id": "seg:paragraph:discussion:0009:0002",
      "source": "Filter the results by identifier using the [`metadataItems(from:filteredByIdentifier:)`](avmetadataitem/metadataitems(from:filteredbyidentifier:).md) method.",
      "ko": "결과를 [`metadataItems(from:filteredByIdentifier:)`](avmetadataitem/metadataitems(from:filteredbyidentifier:).md) 메서드를 사용해 식별자로 필터링할 수 있습니다.",
      "sourceHash": "3fc368973e53ecfe988dea8a8c4b96d26586c9663ac4d4a7ac8621f34b11e129",
      "status": "machine_translated"
    },
