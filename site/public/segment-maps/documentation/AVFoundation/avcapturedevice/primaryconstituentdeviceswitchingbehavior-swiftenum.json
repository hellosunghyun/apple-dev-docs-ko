      "ko": "[AVCaptureDevice.PrimaryConstituentDeviceSwitchingBehavior.restricted](avcapturedevice/primaryconstituentdeviceswitchingbehavior-swift.enum/restricted.md)",
      "sourceHash": "61d8309fa16ab3708dca6ff4e816c25a7d0d36fb5910d2a377aa793e2a085ecb",
