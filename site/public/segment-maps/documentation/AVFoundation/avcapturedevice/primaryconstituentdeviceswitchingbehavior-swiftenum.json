      "status": "preserved"
    },
    {
      "id": "seg:paragraph:switching-behaviors:0015:0001",
      "source": "The device automatically selects the best camera for the current scene.",
      "ko": "장치가 현재 장면에 가장 적합한 카메라를 자동으로 선택합니다.",
      "sourceHash": "a61143add54f368ddcc8e46cc48db6c1ee630a426e426cf9c6f013b13e052f1f",
      "status": "machine_translated"
    },
    {
