    {
      "id": "seg:code:declaration:0006:0001",
      "source": "```swift\nvar activeDepthDataMinFrameDuration: CMTime { get set }\n```",
      "ko": "```swift\nvar activeDepthDataMinFrameDuration: CMTime { get set }\n```",
      "sourceHash": "060fce5ee40f6fcc036723e459ecba2e24f91b312e01153442cac04ed7dfb083",
