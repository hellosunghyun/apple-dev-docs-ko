    {
      "id": "seg:paragraph:discussion:0008:0001",
      "source": "Setting a value specifies a maximum for the captured image.",
      "ko": "By default, `AVCaptureScreenInput` captures the video buffers from the display at a scale factor of 1.0 (no scaling).",
      "sourceHash": "825f4c6aa78ab7b4b0e6f149f267350d3984659414df064d897ea9d563530e39",
      "status": "machine_translated"
    },
    {
      "id": "seg:paragraph:discussion:0008:0002",
      "source": "The dimensions must match one of the dimensions returned by capture device’s active format’s [`supportedMaxPhotoDimensions`](avcapturedevice/format/supportedmaxphotodimensions.md), and be equal to or smaller than the value of the photo outputs [`maxPhotoDimensions`](avcapturephotooutput/maxphotodimensions.md).",
      "ko": "Set this property to scale the buffers by a given factor; for example a 320x240 capture area with a scaleFactor of `2.0` produces video buffers at 640x480.",
      "sourceHash": "5bea8b65e220bd13b1d7bfe80e88b741f3a10d67c3f1ad1a8ac65e5eea06966a",
      "status": "machine_translated"
    },
    {
      "id": "seg:paragraph:discussion:0009:0001",
      "source": "This property defaults to the smallest dimensions returned by [`supportedMaxPhotoDimensions`](avcapturedevice/format/supportedmaxphotodimensions.md).",
      "ko": "이 속성의 기본값은 [`supportedMaxPhotoDimensions`](avcapturedevice/format/supportedmaxphotodimensions.md)에서 반환되는 가장 작은 치수입니다.",
      "sourceHash": "b9d6fb978273dced0499d09b477c740fa196a2ebe6756dc6dfdfdc5f8b42d27b",
      "status": "machine_translated"
    },
