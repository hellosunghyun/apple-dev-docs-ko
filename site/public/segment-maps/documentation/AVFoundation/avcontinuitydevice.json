    {
      "id": "seg:paragraph:overview:0008:0001",
      "source": "Each continuity device instance represents another iOS device that’s nearby.",
      "ko": "각 연속성 디바이스 인스턴스는 근처에 있는 다른 iOS 기기를 나타냅니다.",
      "sourceHash": "d97d2feaba8052bdc608ca5d3c7e39dd56b82cf63ba8da4327ba0c5acc673d6c",
      "status": "machine_translated"
    },
    {
      "id": "seg:paragraph:overview:0008:0002",
      "source": "Your app can access the other device’s cameras and microphones with its [`videoDevices`](avcontinuitydevice/videodevices.md) and [`audioSessionInputs`](avcontinuitydevice/audiosessioninputs.md) properties, respectively.",
      "ko": "앱은 각각 [`videoDevices`](avcontinuitydevice/videodevices.md) 및 [`audioSessionInputs`](avcontinuitydevice/audiosessioninputs.md) 속성을 통해 다른 기기의 카메라와 마이크에 액세스할 수 있습니다.",
      "sourceHash": "1c29e43a4249900f547389880ad5b12d7501804c0dc1efabf09ec05aabd86450",
      "status": "machine_translated"
    },
