      "ko": "[func insertTimeRange(CMTimeRange, of: AVAsset, at: CMTime) throws](avmutablecomposition/inserttimerange(_:of:at:).md)",
      "sourceHash": "ef269eea5cc83745ffb10238d87dbf9b4487d7b748d607868cbdac7cbbe01279",
