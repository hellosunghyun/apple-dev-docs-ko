      "ko": "[func selectedMediaPresentationLanguage(for: AVMediaSelectionGroup) -> String?](avplayeritem/selectedmediapresentationlanguage(for:).md)",
      "sourceHash": "b2bf7b06c2bdae16475ca116e642ea56b0c2e7ef0083706bbc332793e06c6d10",
