    {
      "id": "seg:paragraph:discussion:0008:0001",
      "source": "The value `(i, j, k, l, m, n, o)` is at index:",
      "ko": "값 `(i, j, k, l, m, n, o)`의 인덱스는 다음과 같습니다:",
      "sourceHash": "a612bae9c1c25f94a149b5ed98c08306ee470fd2c24bdb1c52ab0dafed1767fd",
      "status": "machine_translated"
    },
    {
      "id": "seg:paragraph:discussion:0009:0001",
      "source": "`o * stride[0] + n * stride[1] + m * stride[2] + l * stride[3] +`",
      "ko": "`o * stride[0] + n * stride[1] + m * stride[2] + l * stride[3] +`",
      "sourceHash": "4c69ee189b117e5b55c6a9e346196f7ed4a19178340a8976b4480d0655adb43d",
      "status": "preserved"
    },
    {
      "id": "seg:paragraph:discussion:0010:0001",
      "source": "`k * stride[4] + j * stride[5] + i * stride[6]`.",
      "ko": "`k * stride[4] + j * stride[5] + i * stride[6]`.",
      "sourceHash": "3ecd105b01e43a6b6936696c57e3ca1cf4278e73c0c8746966047d198aa643ab",
      "status": "machine_translated"
    },
    {
      "id": "seg:list:discussion:0011:0001",
      "source": "`size[0]` is the size of the first dimension (`i`).",
      "ko": "`size[0]`은 첫 번째 차원(`i`)의 크기입니다.",
      "sourceHash": "0dad67fcfdf43e4abda2c65995abe3a7519eea8590aa838a681fcd8df454deb0",
      "status": "machine_translated"
    },
    {
      "id": "seg:list:discussion:0011:0002",
      "source": "`size[1]` is the size of the second dimension (`j`).",
      "ko": "`size[1]`은 두 번째 차원(`j`)의 크기입니다.",
      "sourceHash": "bca76c7f0ac4ed54ed7beef3f75f8327ae0ffc2904937fd59c88acddcc1f3a0f",
      "status": "machine_translated"
    },
    {
      "id": "seg:list:discussion:0011:0003",
      "source": "`size[2]` is the size of the third dimension (`k`).",
      "ko": "`size[2]`은 세 번째 차원(`k`)의 크기입니다.",
      "sourceHash": "b778fc42ae7ed965a5541adf5b8f7317c655f188473d7e5a9dd4d817bdc4fd8b",
      "status": "machine_translated"
    },
    {
      "id": "seg:list:discussion:0011:0004",
      "source": "`size[3]` is the size of the fourth dimension (`l`).",
      "ko": "`size[3]`은 네 번째 차원(`l`)의 크기입니다.",
      "sourceHash": "e0005bdbc306ecd0f69508c904dd4ea0d096c62e768438af83f6a4a5914ac07b",
      "status": "machine_translated"
    },
    {
      "id": "seg:list:discussion:0011:0005",
      "source": "`size[4]` is the size of the fifth dimension (`m`).",
      "ko": "`size[4]`은 다섯 번째 차원(`m`)의 크기입니다.",
      "sourceHash": "543e776d3a577bb2aba91adf6636b613a9daa068f8eb8bcd16f12d431d284d22",
      "status": "machine_translated"
    },
    {
      "id": "seg:list:discussion:0011:0006",
      "source": "`size[5]` is the size of the sixth dimension (`n`).",
      "ko": "`size[5]`은 여섯 번째 차원(`n`)의 크기입니다.",
      "sourceHash": "789eaa72e896f56c1cc0972027b3fcaa1fac5472c51d866e64d1228f669875a8",
      "status": "machine_translated"
    },
    {
      "id": "seg:list:discussion:0011:0007",
      "source": "`size[6]` is the size of the seventh dimension (`o`).",
      "ko": "`size[6]`은 일곱 번째 차원(`o`)의 크기입니다.",
      "sourceHash": "065585a6e93146514a40ac172a10ec5a2eb0175b0a27c14db1d83fda4c035a93",
      "status": "machine_translated"
    },
