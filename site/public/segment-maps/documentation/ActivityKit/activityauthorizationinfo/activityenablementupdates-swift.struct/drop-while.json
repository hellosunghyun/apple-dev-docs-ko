    },
    {
      "id": "seg:paragraph:dropwhile:0001:0001",
      "source": "**Framework**: ActivityKit **Kind**: method",
      "ko": "**Framework**: ActivityKit **Kind**: method",
      "sourceHash": "5aa0baa3c5963fd4f7d4848a7671bd8d80441d96f190fe17ae3602b48c598712",
      "status": "preserved"
    },
    {
      "id": "seg:paragraph:dropwhile:0002:0001",
      "source": "Omits elements from the base asynchronous sequence until a given closure returns false, after which it passes through all remaining elements.",
      "ko": "주어진 클로저가 false를 반환할 때까지 기본 비동기 시퀀스에서 요소를 생략하고, 이후에는 나머지 모든 요소를 그대로 전달합니다.",
      "sourceHash": "62a75716a6e3c10b97c1bdcdb155c59e50b571b7c23d71aeadf2c8ee549e956a",
      "status": "machine_translated"
    },
    {
      "id": "seg:paragraph:dropwhile:0003:0001",
      "source": "**Availability**:",
      "ko": "**Availability**:",
      "sourceHash": "c54a2ed36492f9321cad7af43ab3edbbabcab53520c009f69016847ac8028dc3",
      "status": "preserved"
    },
