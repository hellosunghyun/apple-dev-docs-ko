    {
      "id": "seg:code:declaration:0006:0001",
      "source": "```swift\n@preconcurrency\nfunc filter(_ isIncluded: @escaping (Self.Element) async -> Bool) -> AsyncFilterSequence<Self>\n```",
      "ko": "```swift\n@preconcurrency\nfunc filter(_ isIncluded: @escaping (Self.Element) async -> Bool) -> AsyncFilterSequence<Self>\n```",
      "sourceHash": "8aa0f5fae0100432300270aa27c85331632b3c040a64773f35fad026bf4c2da7",
      "status": "preserved"
    },
    {
      "id": "seg:heading:return-value:0007:0001",
