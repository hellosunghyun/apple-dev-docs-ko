    {
      "id": "seg:code:declaration:0006:0001",
      "source": "```swift\nstatic func != (lhs: Self, rhs: Self) -> Bool\n```",
      "ko": "```swift\nstatic func != (lhs: Self, rhs: Self) -> Bool\n```",
