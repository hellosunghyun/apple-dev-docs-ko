    {
      "id": "seg:paragraph:discussion:0012:0002",
      "blockId": "paragraph:discussion:0012",
      "type": "sentence",
      "source": "In contrast with [`subscribe(on:options:)`](publisher/subscribe(on:options:).md), which affects upstream messages, [`receive(on:options:)`](publisher/receive(on:options:).md) changes the execution context of downstream messages.",
      "normalizedSource": "In contrast with [`subscribe(on:options:)`](publisher/subscribe(on:options:).md), which affects upstream messages, [`receive(on:options:)`](publisher/receive(on:options:).md) changes the execution context of downstream messages.",
      "sourceHash": "e5dd27d2c53cf15b22cdb2514609f14e5b00a3bb6f0dfd79d4b5ef615e462e5c",
      "translatable": true,
      "contextBefore": "You use the [`receive(on:options:)`](publisher/receive(on:options:).md) operator to receive results and completion on a specific scheduler, such as performing UI work on the main run loop.",
      "contextAfter": "In the following example, the [`subscribe(on:options:)`](publisher/subscribe(on:options:).md) operator causes `jsonPublisher` to receive requests on `backgroundQueue`, while the [`receive(on:options:)`](publisher/receive(on:options:).md) causes `labelUpdater` to receive elements and completion on `RunLoop.main`.",
      "documentTitle": "receive(on:options:)",
      "framework": "Combine",
      "ko": "",
      "status": "failed",
      "reviewed": false,
      "locked": false
