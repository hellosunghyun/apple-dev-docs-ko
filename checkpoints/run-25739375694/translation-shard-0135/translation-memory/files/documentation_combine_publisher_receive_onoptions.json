    {
      "id": "seg:paragraph:discussion:0012:0001",
      "blockId": "paragraph:discussion:0012",
      "type": "sentence",
      "source": "You use the [`receive(on:options:)`](publisher/receive(on:options:).md) operator to receive results and completion on a specific scheduler, such as performing UI work on the main run loop.",
      "normalizedSource": "You use the [`receive(on:options:)`](publisher/receive(on:options:).md) operator to receive results and completion on a specific scheduler, such as performing UI work on the main run loop.",
      "sourceHash": "4f96423e30121aa533508ad40d26812f9b214ef649bde9db7ba15f8334d8dcf9",
      "translatable": true,
      "contextBefore": "Discussion",
      "contextAfter": "In contrast with [`subscribe(on:options:)`](publisher/subscribe(on:options:).md), which affects upstream messages, [`receive(on:options:)`](publisher/receive(on:options:).md) changes the execution context of downstream messages.",
      "documentTitle": "receive(on:options:)",
      "framework": "Combine",
      "ko": "",
      "status": "failed",
      "reviewed": false,
      "locked": false
