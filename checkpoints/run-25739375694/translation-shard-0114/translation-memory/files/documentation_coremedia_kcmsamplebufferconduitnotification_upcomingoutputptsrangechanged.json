      "id": "seg:paragraph:discussion:0008:0001",
      "blockId": "paragraph:discussion:0008",
      "type": "sentence",
      "source": "This information can be important for frame-reordered video and for certain types of decoding where samples are transmitted in a different order from the order they will be displayed.",
      "normalizedSource": "This information can be important for frame-reordered video and for certain types of decoding where samples are transmitted in a different order from the order they will be displayed.",
      "sourceHash": "7a2c709507de300f4c9817e13bda7a004a44a1f3def788e11df164f0ec2b6907",
      "translatable": true,
      "contextBefore": "Discussion",
      "contextAfter": "If you need to process frames in presentation order, you can use this information to ensure that you do not process a frame too early (that is, when there are upcoming frames that will have earlier presentation timestamps than a frame to be processed).",
      "documentTitle": "kCMSampleBufferConduitNotificationUpcomingOutputPTSRangeChanged",
      "framework": "CoreMedia",
