    {
      "id": "seg:paragraph:discussion:0009:0001",
      "blockId": "paragraph:discussion:0009",
      "type": "sentence",
      "source": "The `userInfo` dictionary for this notification contains the [`kCMSampleBufferConduitNotificationParameter_UpcomingOutputPTSRangeMayOverlapQueuedOutputPTSRange`](kcmsamplebufferconduitnotificationparameter_upcomingoutputptsrangemayoverlapqueuedoutputptsrange.md) key.",
      "normalizedSource": "The `userInfo` dictionary for this notification contains the [`kCMSampleBufferConduitNotificationParameter_UpcomingOutputPTSRangeMayOverlapQueuedOutputPTSRange`](kcmsamplebufferconduitnotificationparameter_upcomingoutputptsrangemayoverlapqueuedoutputptsrange.md) key.",
      "sourceHash": "9d6d7072fab77a388865ba379459517bda718acfe4c6782fd0bed45624f4e322",
      "translatable": true,
      "contextBefore": "If you need to process frames in presentation order, you can use this information to ensure that you do not process a frame too early (that is, when there are upcoming frames that will have earlier presentation timestamps than a frame to be processed).",
      "contextAfter": "If the value for that key is [`kCFBooleanTrue`](https://developer.apple.com/documentation/CoreFoundation/kCFBooleanTrue), the dictionary also contains one or both of the [`kCMSampleBufferConduitNotificationParameter_MinUpcomingOutputPTS`](kcmsamplebufferconduitnotificationparameter_minupcomingoutputpts.md) or [`kCMSampleBufferConduitNotificationParameter_MaxUpcomingOutputPTS`](kcmsamplebufferconduitnotificationparameter_maxupcomingoutputpts.md) keys providing information about the range of overlapping presentation timestamps.",
      "documentTitle": "kCMSampleBufferConduitNotificationUpcomingOutputPTSRangeChanged",
      "framework": "CoreMedia",
      "ko": "",
      "status": "failed",
      "reviewed": false,
      "locked": false
    },
