      "source": "```swift\nimport SwiftUI\nimport TipKit\n\n@main\nstruct LandmarkTips: App {\n    var body: some Scene {\n        WindowGroup {\n            ContentView()\n        }\n    }\n\n    init() {\n        setupTips()\n    }\n\n    // Configure tips in the app.\n    func setupTips() {\n        do {\n            #if DEBUG\n            Tips.showAllTipsForTesting()\n            #endif\n\n            try Tips.configure()\n        }\n        catch {\n            print(\"Error initializing TipKit \\(error.localizedDescription)\")\n        }\n    }\n}\n```",
