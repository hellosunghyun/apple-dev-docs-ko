      "id": "seg:paragraph:discussion:0008:0001",
      "blockId": "paragraph:discussion:0008",
      "type": "sentence",
      "source": "If the clip view is contained in an [`NSScrollView`](nsscrollview.md), you should send the [`NSScrollView`](nsscrollview.md) a [`documentView`](nsscrollview/documentview.md) message instead, so it can perform whatever updating it needs.",
      "normalizedSource": "If the clip view is contained in an [`NSScrollView`](nsscrollview.md), you should send the [`NSScrollView`](nsscrollview.md) a [`documentView`](nsscrollview/documentview.md) message instead, so it can perform whatever updating it needs.",
      "sourceHash": "129ed9debc61fae42027fc0ca086a59e2d15ef54b8c1a3642862607a333277d5",
      "translatable": true,
      "contextBefore": "Discussion",
      "contextAfter": "Setting this property to a view removes any previous document view, and sets the origin of the clip view’s bounds rectangle to the origin of the new view’s frame rectangle.",
      "documentTitle": "documentView",
      "framework": "AppKit",
