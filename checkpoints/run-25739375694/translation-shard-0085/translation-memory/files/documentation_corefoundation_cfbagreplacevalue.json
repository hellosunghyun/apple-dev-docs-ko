    {
      "id": "seg:list:parameters:0010:0001",
      "blockId": "list:parameters:0010",
      "type": "list_item",
      "source": "`theBag`: The bag from which `value` is to be replaced.",
      "normalizedSource": "`theBag`: The bag from which `value` is to be replaced.",
      "sourceHash": "459678f72ee406cf2b645425a90f401987ed8d05f1fb1c8a9b6859a8fc75bf33",
      "translatable": true,
      "contextBefore": "Parameters",
      "contextAfter": "`value`: The value to be replaced in the collection. If this value does not already exist in the collection, the function does nothing. You may pass the value itself instead of a pointer if it is pointer-size or less. The equal callback provided when `theBag` was created is used to compare. If the equal callback was `NULL`, pointer equality (in C, ==) is used. If `value`, or any other value in `theBag`, is not understood by the equal callback, the behavior is undefined.",
      "documentTitle": "CFBagReplaceValue(::)",
      "framework": "CoreFoundation",
