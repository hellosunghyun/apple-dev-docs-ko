    {
      "id": "seg:paragraph:discussion:0010:0001",
      "blockId": "paragraph:discussion:0010",
      "type": "sentence",
      "source": "Use [`setFailureType(to:)`](publisher/setfailuretype(to:).md) when you need set the error type of a publisher that cannot fail.",
      "normalizedSource": "Use [`setFailureType(to:)`](publisher/setfailuretype(to:).md) when you need set the error type of a publisher that cannot fail.",
      "sourceHash": "eb6e2681f98e8a32e76b9d5bad00a063b08991f6ee2a3eefe61cc49b8785a7bb",
      "translatable": true,
      "contextBefore": "Discussion",
      "contextAfter": "Conversely, if the upstream can fail, you would use [`mapError(_:)`](publisher/maperror(_:).md) to provide instructions on converting the error types to needed by the downstream publisher’s inputs.",
      "documentTitle": "setFailureType(to:)",
      "framework": "Combine",
