    {
      "id": "seg:paragraph:discussion:0008:0001",
      "blockId": "paragraph:discussion:0008",
      "type": "sentence",
      "source": "If the given GCD queue is a concurrent queue, XPC cannot guarantee that there will not be multiple reply handlers being invoked concurrently.",
      "normalizedSource": "If the given GCD queue is a concurrent queue, XPC cannot guarantee that there will not be multiple reply handlers being invoked concurrently.",
      "sourceHash": "2e831a7e3c0956558a820764b2d03abbcbd274f04bd1b358f64d4d2ada7d37a4",
      "translatable": true,
      "contextBefore": "Discussion",
      "contextAfter": "XPC does not guarantee any ordering for the invocation of reply handers.",
      "documentTitle": "xpcconnectionsendmessagewithreply(::::)",
      "framework": "XPC",
