    {
      "id": "seg:paragraph:discussion:0008:0002",
      "blockId": "paragraph:discussion:0008",
      "type": "sentence",
      "source": "XPC does not guarantee any ordering for the invocation of reply handers.",
      "normalizedSource": "XPC does not guarantee any ordering for the invocation of reply handers.",
      "sourceHash": "ab57dc99e063c1c52f7f3716f66ffff6b77c94757cd9ae5f525441683f947e91",
      "translatable": true,
      "contextBefore": "If the given GCD queue is a concurrent queue, XPC cannot guarantee that there will not be multiple reply handlers being invoked concurrently.",
      "contextAfter": "So if multiple messages are waiting for replies and the connection goes invalid, there is no guarantee that the reply handlers will be invoked in FIFO order.",
      "documentTitle": "xpcconnectionsendmessagewithreply(::::)",
      "framework": "XPC",
      "ko": "",
      "status": "failed",
      "reviewed": false,
      "locked": false
