      "id": "seg:code:discussion:0009:0001",
      "blockId": "code:discussion:0009",
      "type": "preserve",
      "source": "```swift\nclass DataModel: ObservableObject {\n    @Published var name = \"Some Name\"\n    @Published var isEnabled = false\n}\n\nstruct MyView: View {\n    @StateObject private var model = DataModel()\n\n    var body: some View {\n        Text(model.name)\n        MySubView(model: model)\n    }\n}\n\nstruct MySubView: View {\n    @ObservedObject var model: DataModel\n\n    var body: some View {\n        Toggle(\"Enabled\", isOn: $model.isEnabled)\n    }\n}\n```",
      "normalizedSource": "```swift class DataModel: ObservableObject { @Published var name = \"Some Name\" @Published var isEnabled = false } struct MyView: View { @StateObject private var model = DataModel() var body: some View { Text(model.name) MySubView(model: model) } } struct MySubView: View { @ObservedObject var model: DataModel var body: some View { Toggle(\"Enabled\", isOn: $model.isEnabled) } } ```",
      "sourceHash": "fe9d7d637295d119482003327a3827bdc850d298e3962147a5a95490782fc782",
      "translatable": false,
      "preserveReason": "code",
      "contextBefore": "Unlike a [`StateObject`](stateobject.md) which manages data storage, you use an observed object to refer to storage that you manage elsewhere, as in the following example:",
      "contextAfter": "Explicitly calling the observed object initializer in `MySubView` would behave correctly, but would needlessly recreate the same observed object instance every time SwiftUI calls the view’s initializer to redraw the view.",
      "documentTitle": "init(wrappedValue:)",
      "framework": "SwiftUI",
      "ko": "```swift\nclass DataModel: ObservableObject {\n    @Published var name = \"Some Name\"\n    @Published var isEnabled = false\n}\n\nstruct MyView: View {\n    @StateObject private var model = DataModel()\n\n    var body: some View {\n        Text(model.name)\n        MySubView(model: model)\n    }\n}\n\nstruct MySubView: View {\n    @ObservedObject var model: DataModel\n\n    var body: some View {\n        Toggle(\"Enabled\", isOn: $model.isEnabled)\n    }\n}\n```",
