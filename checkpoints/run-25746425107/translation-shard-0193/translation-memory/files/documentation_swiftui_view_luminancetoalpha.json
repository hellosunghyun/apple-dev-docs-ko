      "contextAfter": "```swift\nstruct Palette: View {\n    var body: some View {\n        HStack(spacing: 0) {\n            ForEach(0..<10) { index in\n                Color(white: Double(index) / Double(9))\n                    .frame(width: 20, height: 40)\n            }\n        }\n    }\n}\n\nstruct LuminanceToAlphaExample: View {\n    var body: some View {\n        VStack(spacing: 20) {\n            Palette()\n\n            Palette()\n                .luminanceToAlpha()\n        }\n        .padding()\n        .background(.blue)\n    }\n}\n```",
