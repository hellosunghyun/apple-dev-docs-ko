      "id": "seg:paragraph:discussion:0008:0001",
      "blockId": "paragraph:discussion:0008",
      "type": "sentence",
      "source": "If the value of this property is [`CLAccuracyAuthorization.fullAccuracy`](claccuracyauthorization/fullaccuracy.md), you can set the [`desiredAccuracy`](cllocationmanager/desiredaccuracy.md) property to any value.",
      "normalizedSource": "If the value of this property is [`CLAccuracyAuthorization.fullAccuracy`](claccuracyauthorization/fullaccuracy.md), you can set the [`desiredAccuracy`](cllocationmanager/desiredaccuracy.md) property to any value.",
      "sourceHash": "2f871d82033ea5671451cfe1af9c63b3394dbd94b8c6a8c6a15e1479868b9b0e",
      "translatable": true,
      "contextBefore": "Discussion",
      "contextAfter": "If the value is [`CLAccuracyAuthorization.reducedAccuracy`](claccuracyauthorization/reducedaccuracy.md), setting [`desiredAccuracy`](cllocationmanager/desiredaccuracy.md) to a value other than [`kCLLocationAccuracyReduced`](kcllocationaccuracyreduced.md) has no effect on the location information, and your app can’t use region monitoring or beacon ranging.",
      "documentTitle": "accuracyAuthorization",
      "framework": "CoreLocation",
      "ko": "",
      "status": "failed",
      "reviewed": false,
