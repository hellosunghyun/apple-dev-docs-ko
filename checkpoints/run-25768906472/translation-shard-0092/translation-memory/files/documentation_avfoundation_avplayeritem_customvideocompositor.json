    {
      "id": "seg:paragraph:discussion:0008:0001",
      "blockId": "paragraph:discussion:0008",
      "type": "sentence",
      "source": "The custom video compositor instance that is used during image generation is accessible via this property after the value of [`videoComposition`](avplayeritem/videocomposition.md) is set to an [`AVVideoComposition`](avvideocomposition.md) instance that specifies a custom video compositor class.",
      "normalizedSource": "The custom video compositor instance that is used during image generation is accessible via this property after the value of [`videoComposition`](avplayeritem/videocomposition.md) is set to an [`AVVideoComposition`](avvideocomposition.md) instance that specifies a custom video compositor class.",
      "sourceHash": "9acabc6d49557be4ce1118d1c957c22053e04ed7b518f2afcdcd0be41bcd4a38",
      "translatable": true,
      "contextBefore": "Discussion",
      "contextAfter": "Any additional communication between the application and that instance of the custom video compositor, if any is required for configuration or other purposes, can only occur once that has happened.",
      "documentTitle": "customVideoCompositor",
      "framework": "AVFoundation",
      "ko": "",
      "status": "failed",
      "reviewed": false,
      "locked": false
    },
    {
      "id": "seg:paragraph:discussion:0008:0002",
      "blockId": "paragraph:discussion:0008",
      "type": "sentence",
      "source": "Any additional communication between the application and that instance of the custom video compositor, if any is required for configuration or other purposes, can only occur once that has happened.",
      "normalizedSource": "Any additional communication between the application and that instance of the custom video compositor, if any is required for configuration or other purposes, can only occur once that has happened.",
      "sourceHash": "eda6f3c4c91772f05ded640bc3b161a408f8e9af3c362952b44b9e8d67319c56",
      "translatable": true,
      "contextBefore": "The custom video compositor instance that is used during image generation is accessible via this property after the value of [`videoComposition`](avplayeritem/videocomposition.md) is set to an [`AVVideoComposition`](avvideocomposition.md) instance that specifies a custom video compositor class.",
      "contextAfter": "If the value of [`videoComposition`](avplayeritem/videocomposition.md) is changed from an [`AVVideoComposition`](avvideocomposition.md) that specifies a custom video compositor class to another instance of [`AVVideoComposition`](avvideocomposition.md) that specifies the same custom video compositor class, the instance of the custom video compositor that was previously created will receive the [`renderContextChanged(_:)`](avvideocompositing/rendercontextchanged(_:).md) message and remain in use for subsequent image generation.",
      "documentTitle": "customVideoCompositor",
      "framework": "AVFoundation",
      "ko": "",
      "status": "failed",
      "reviewed": false,
      "locked": false
    },
    {
      "id": "seg:paragraph:discussion:0009:0001",
      "blockId": "paragraph:discussion:0009",
      "type": "sentence",
      "source": "If the value of [`videoComposition`](avplayeritem/videocomposition.md) is changed from an [`AVVideoComposition`](avvideocomposition.md) that specifies a custom video compositor class to another instance of [`AVVideoComposition`](avvideocomposition.md) that specifies the same custom video compositor class, the instance of the custom video compositor that was previously created will receive the [`renderContextChanged(_:)`](avvideocompositing/rendercontextchanged(_:).md) message and remain in use for subsequent image generation.",
      "normalizedSource": "If the value of [`videoComposition`](avplayeritem/videocomposition.md) is changed from an [`AVVideoComposition`](avvideocomposition.md) that specifies a custom video compositor class to another instance of [`AVVideoComposition`](avvideocomposition.md) that specifies the same custom video compositor class, the instance of the custom video compositor that was previously created will receive the [`renderContextChanged(_:)`](avvideocompositing/rendercontextchanged(_:).md) message and remain in use for subsequent image generation.",
      "sourceHash": "70a497b0982c500538ab1cede90036f5cb37505b12f81a4a9e56602a75b45a0b",
      "translatable": true,
      "contextBefore": "Any additional communication between the application and that instance of the custom video compositor, if any is required for configuration or other purposes, can only occur once that has happened.",
      "contextAfter": "This property is `nil` if there is no video compositor, or if the internal video compositor is in use.",
      "documentTitle": "customVideoCompositor",
      "framework": "AVFoundation",
      "ko": "",
      "status": "failed",
      "reviewed": false,
      "locked": false
    },
    {
      "id": "seg:paragraph:discussion:0010:0001",
      "blockId": "paragraph:discussion:0010",
      "type": "sentence",
      "source": "This property is `nil` if there is no video compositor, or if the internal video compositor is in use.",
      "normalizedSource": "This property is `nil` if there is no video compositor, or if the internal video compositor is in use.",
      "sourceHash": "b9cd61db01561b57a88aeef34b468cb1ce39f9df21be09386b5550631c8c52a1",
      "translatable": true,
      "contextBefore": "If the value of [`videoComposition`](avplayeritem/videocomposition.md) is changed from an [`AVVideoComposition`](avvideocomposition.md) that specifies a custom video compositor class to another instance of [`AVVideoComposition`](avvideocomposition.md) that specifies the same custom video compositor class, the instance of the custom video compositor that was previously created will receive the [`renderContextChanged(_:)`](avvideocompositing/rendercontextchanged(_:).md) message and remain in use for subsequent image generation.",
