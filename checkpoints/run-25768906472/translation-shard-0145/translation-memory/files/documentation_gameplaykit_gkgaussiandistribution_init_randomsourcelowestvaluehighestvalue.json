      "translatable": true,
      "contextBefore": "Discussion",
      "contextAfter": "The [`mean`](gkgaussiandistribution/mean.md) property is set to the midpoint between the `lowestInclusive` and `highestInclusive` parameters (`mean = (highest + lowest) / 2`), and the [`deviation`](gkgaussiandistribution/deviation.md) property is set such that the highest and lowest values are each three deviations away from the mean (`deviation = (highest - lowest) / 6`).",
      "documentTitle": "init(randomSource:lowestValue:highestValue:)",
