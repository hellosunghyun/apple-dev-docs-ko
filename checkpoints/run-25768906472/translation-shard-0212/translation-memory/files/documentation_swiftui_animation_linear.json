      "contextAfter": "```swift\nstruct ContentView: View {\n    @State private var isActive = false\n\n    var body: some View {\n        VStack(alignment: isActive ? .trailing : .leading) {\n            Circle()\n                .fill(isActive ? Color.red : Color.blue)\n                .frame(width: 50, height: 50)\n\n            Button(\"Animate\") {\n                withAnimation(.linear) {\n                    isActive.toggle()\n                }\n            }\n            .frame(maxWidth: .infinity)\n        }\n    }\n}\n```",
