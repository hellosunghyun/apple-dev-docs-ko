      "locked": false
    },
    {
      "id": "seg:paragraph:discussion:0010:0003",
      "blockId": "paragraph:discussion:0010",
      "type": "sentence",
      "source": "If a token is found, it is set as the current token and the function returns `true`; otherwise the current token is invalidated and the function returns `false`.",
      "normalizedSource": "If a token is found, it is set as the current token and the function returns `true`; otherwise the current token is invalidated and the function returns `false`.",
      "sourceHash": "ffa209271fbc95888a3812b11288af53e20f24cbff244028d23106ea4f7c3e9e",
      "translatable": true,
      "contextBefore": "If there is a preceding, successful, call to [`CFStringTokenizerGoToTokenAtIndex(_:_:)`](cfstringtokenizergototokenatindex(_:_:).md) or [`CFStringTokenizerAdvanceToNextToken(_:)`](cfstringtokenizeradvancetonexttoken(_:).md) and there is a current token, proceeds to the next token.",
