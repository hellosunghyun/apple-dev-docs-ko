    {
      "id": "seg:paragraph:discussion:0012:0001",
      "blockId": "paragraph:discussion:0012",
      "type": "sentence",
      "source": "It is safe to call this function concurrently on two or more threads as long as it is not used to change the value of a trust management object that is simultaneously being used by another function.",
      "normalizedSource": "It is safe to call this function concurrently on two or more threads as long as it is not used to change the value of a trust management object that is simultaneously being used by another function.",
      "sourceHash": "2d68f9783244a5308720f188f724fe4277f7bec5d7827c496a0a9633f4c91c9d",
      "translatable": true,
      "contextBefore": "Discussion",
      "contextAfter": "For example, you cannot call this function on one thread at the same time as you are calling the [`SecTrustEvaluateWithError(_:_:)`](sectrustevaluatewitherror(_:_:).md) function for the same trust management object on another thread, but you can call this function and simultaneously evaluate a different trust management object on another thread.",
      "documentTitle": "SecTrustSetAnchorCertificatesOnly(::)",
      "framework": "Security",
      "ko": "",
      "status": "failed",
      "reviewed": false,
      "locked": false
