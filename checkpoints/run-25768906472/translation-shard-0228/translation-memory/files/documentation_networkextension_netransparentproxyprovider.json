      "id": "seg:paragraph:overview:0010:0001",
      "blockId": "paragraph:overview:0010",
      "type": "sentence",
      "source": "The [`NETransparentProxyProvider`](netransparentproxyprovider.md) class has the following behavior differences from its superclass [`NEAppProxyProvider`](neappproxyprovider.md):",
      "normalizedSource": "The [`NETransparentProxyProvider`](netransparentproxyprovider.md) class has the following behavior differences from its superclass [`NEAppProxyProvider`](neappproxyprovider.md):",
      "sourceHash": "5d9814419b014acebbdaea3fc0b1b20dce07c3b58d3bb36f5dd7197ac4a08b8a",
      "translatable": true,
      "contextBefore": "Overview",
      "contextAfter": "Returning `NO` from [`handleNewFlow(_:)`](neappproxyprovider/handlenewflow(_:).md) and [`handleNewUDPFlow(_:initialRemoteEndpoint:)`](neappproxyprovider/handlenewudpflow(_:initialremoteendpoint:).md) causes the flow to proceed to communicate directly with the flow’s ultimate destination, instead of closing the flow with a “Connection Refused” error.",
      "documentTitle": "NETransparentProxyProvider",
      "framework": "NetworkExtension",
      "ko": "",
      "status": "failed",
      "reviewed": false,
      "locked": false
