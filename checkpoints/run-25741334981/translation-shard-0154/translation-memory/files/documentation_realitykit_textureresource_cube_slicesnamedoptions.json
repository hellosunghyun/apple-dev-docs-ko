    {
      "id": "seg:paragraph:discussion:0010:0001",
      "blockId": "paragraph:discussion:0010",
      "type": "sentence",
      "source": "Use the resulting texture to create an [`EnvironmentResource`](environmentresource.md), or assign it to a material in Reality Composer Pro that requires a cube texture type.",
      "normalizedSource": "Use the resulting texture to create an [`EnvironmentResource`](environmentresource.md), or assign it to a material in Reality Composer Pro that requires a cube texture type.",
      "sourceHash": "4d032010097108e1213d6246c6f3056ee53c8811bd5124a9c3b4e81344347cc8",
      "translatable": true,
