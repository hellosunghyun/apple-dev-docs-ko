      "id": "seg:paragraph:overview:0008:0002",
      "blockId": "paragraph:overview:0008",
      "type": "sentence",
      "source": "You access the publisher with the `$` operator, as shown here:",
      "normalizedSource": "You access the publisher with the `$` operator, as shown here:",
      "sourceHash": "b0aa6c849bedd6f50acb8cacf9ed0c7006df17aad0a256bb42a7300c9140fe38",
      "translatable": true,
      "contextBefore": "Publishing a property with the `@Published` attribute creates a publisher of this type.",
      "contextAfter": "```swift\nclass Weather {\n    @Published var temperature: Double\n    init(temperature: Double) {\n        self.temperature = temperature\n    }\n}\n\nlet weather = Weather(temperature: 20)\ncancellable = weather.$temperature\n    .sink() {\n        print (\"Temperature now: \\($0)\")\n}\nweather.temperature = 25\n\n// Prints:\n// Temperature now: 20.0\n// Temperature now: 25.0\n```",
      "documentTitle": "Published",
      "framework": "Combine",
