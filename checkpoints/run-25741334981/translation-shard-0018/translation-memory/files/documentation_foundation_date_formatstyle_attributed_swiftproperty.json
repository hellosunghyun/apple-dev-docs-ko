      "blockId": "code:discussion:0010",
      "type": "preserve",
      "source": "```swift\n// Applies visual emphasis to the year component of a formatted attributed date string.\nprivate func makeAttributedString() -> AttributedString {\n    let date = Date()\n    let formatStyle = Date.FormatStyle(date: .abbreviated, time: .standard)\n    var attributedString = formatStyle.attributed.format(date)\n    for run in attributedString.runs {\n        if let dateFieldAttribute = run.attributes.foundation.dateField,\n           dateFieldAttribute == .year {\n            // When you find a year, change its attributes.\n            attributedString[run.range].inlinePresentationIntent = [.emphasized, .stronglyEmphasized]\n        }\n    }\n    return attributedString\n}\n```",
      "normalizedSource": "```swift // Applies visual emphasis to the year component of a formatted attributed date string. private func makeAttributedString() -> AttributedString { let date = Date() let formatStyle = Date.FormatStyle(date: .abbreviated, time: .standard) var attributedString = formatStyle.attributed.format(date) for run in attributedString.runs { if let dateFieldAttribute = run.attributes.foundation.dateField, dateFieldAttribute == .year { // When you find a year, change its attributes. attributedString[run.range].inlinePresentationIntent = [.emphasized, .stronglyEmphasized] } } return attributedString } ```",
