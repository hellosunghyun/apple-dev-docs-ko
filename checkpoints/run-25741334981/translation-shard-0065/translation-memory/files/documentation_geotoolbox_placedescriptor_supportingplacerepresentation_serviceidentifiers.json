    {
      "id": "seg:paragraph:discussion:0008:0001",
      "blockId": "paragraph:discussion:0008",
      "type": "sentence",
      "source": "A service identifier is a [`Dictionary`](https://developer.apple.com/documentation/Swift/Dictionary) that maps a bundle IDs (key) and a unique identifiers (value) that represent a mapping between a specific service provider and their specific identifier for a place.",
      "normalizedSource": "A service identifier is a [`Dictionary`](https://developer.apple.com/documentation/Swift/Dictionary) that maps a bundle IDs (key) and a unique identifiers (value) that represent a mapping between a specific service provider and their specific identifier for a place.",
      "sourceHash": "4ec8b8c6d5d2930105e0ace3d064a33ddbd2a838201e6f51340eb9b8a6d971f3",
      "translatable": true,
      "contextBefore": "Discussion",
      "contextAfter": "For example, the dictionary entry `[com.apple.maps: IBE1F65094A7A13B1]` maps a service provider to a unique ID — here `com.apple.maps`, which represents Apple Maps, and the place ID, `IBE1F65094A7A13B1`, a string that represents the San Francisco Ferry Building, in San Francisco, California.",
      "documentTitle": "PlaceDescriptor.SupportingPlaceRepresentation.serviceIdentifiers(:)",
      "framework": "GeoToolbox",
      "ko": "",
