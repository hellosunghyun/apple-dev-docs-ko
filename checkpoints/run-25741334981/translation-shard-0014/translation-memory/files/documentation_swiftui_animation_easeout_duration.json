      "translatable": true,
      "contextBefore": "Otherwise, use [`easeOut`](animation/easeout.md) to perform the animation for a default length of time.",
      "contextAfter": "```swift\nstruct ContentView: View {\n    @State private var scale = 0.5\n\n    var body: some View {\n        VStack {\n            Circle()\n                .scale(scale)\n                .animation(.easeOut(duration: 1.0), value: scale)\n            HStack {\n                Button(\"+\") { scale += 0.1 }\n                Button(\"-\") { scale -= 0.1 }\n            }\n        }\n    }\n}\n```",
      "documentTitle": "easeOut(duration:)",
      "framework": "SwiftUI",
      "ko": "",
      "status": "failed",
      "reviewed": false,
