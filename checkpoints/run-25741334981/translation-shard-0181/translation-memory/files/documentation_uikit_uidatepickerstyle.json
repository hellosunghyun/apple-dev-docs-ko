      "id": "seg:paragraph:overview:0008:0001",
      "blockId": "paragraph:overview:0008",
      "type": "sentence",
      "source": "A date picker style determines how your app displays the date picker value and its editor.",
      "normalizedSource": "A date picker style determines how your app displays the date picker value and its editor.",
      "sourceHash": "e46a1dba767453f3613ac1f33880abd8bc94a796d6fcfb0e88212e1430cb856c",
      "translatable": true,
      "contextBefore": "Overview",
      "contextAfter": "For instance, a date picker with a [`datePickerMode`](uidatepicker/datepickermode.md) of [`UIDatePicker.Mode.dateAndTime`](uidatepicker/mode/dateandtime.md) and [`datePickerStyle`](uidatepicker/datepickerstyle.md) of [`UIDatePickerStyle.compact`](uidatepickerstyle/compact.md) displays the date picker’s value as a label that the user can tap to view a calendar-style editor.",
      "documentTitle": "UIDatePickerStyle",
      "framework": "UIKit",
      "ko": "",
      "status": "failed",
      "reviewed": false,
      "locked": false
    },
