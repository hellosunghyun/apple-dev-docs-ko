    {
      "id": "seg:paragraph:overview:0009:0001",
      "blockId": "paragraph:overview:0009",
      "type": "sentence",
      "source": "You can synchronize with an agent in either or both directions:",
      "normalizedSource": "You can synchronize with an agent in either or both directions:",
      "sourceHash": "cdd27db5f384dd4dbd35db7e9ab9bc635baeb885aa2c64275a405e318530716d",
      "translatable": true,
      "contextBefore": "Use this protocol to manage an external object related to the agent, such as the sprite or 3D object that provides that agent’s visual representation in your game.",
      "contextAfter": "To update a visual representation based on the latest data from the agent simulation, implement the [`agentDidUpdate(_:)`](gkagentdelegate/agentdidupdate(_:).md) method. In this method you can read the [`position`](gkagent2d/position.md) and [`rotation`](gkagent2d/rotation.md) properties of the agent (as a [`GKAgent2D`](gkagent2d.md) or [`GKAgent3D`](gkagent3d.md) object) and set the corresponding attributes of whatever object provides the agent’s visual representation.",
      "documentTitle": "GKAgentDelegate",
      "framework": "GameplayKit",
      "ko": "",
