    {
      "id": "seg:code:discussion:0009:0001",
      "blockId": "code:discussion:0009",
      "type": "preserve",
      "source": "```swift\nthreadColorButton.pointerStyleProvider = { button, proposedEffect, proposedShape -> UIPointerStyle? in\n    let cornerRadius: CGFloat = 4\n    let parameters = UIPreviewParameters()\n    let shapePath = UIBezierPath(roundedRect: button.bounds, cornerRadius: cornerRadius)\n    parameters.shadowPath = shapePath\n    let preview = UITargetedPreview(view: proposedEffect.preview.view, parameters: parameters, target: proposedEffect.preview.target)\n    \n    let rect = button.convert(button.bounds, to: preview.target.container)\n    return UIPointerStyle(effect: .lift(preview), shape: .roundedRect(rect, radius: cornerRadius))\n}\n```",
      "normalizedSource": "```swift threadColorButton.pointerStyleProvider = { button, proposedEffect, proposedShape -> UIPointerStyle? in let cornerRadius: CGFloat = 4 let parameters = UIPreviewParameters() let shapePath = UIBezierPath(roundedRect: button.bounds, cornerRadius: cornerRadius) parameters.shadowPath = shapePath let preview = UITargetedPreview(view: proposedEffect.preview.view, parameters: parameters, target: proposedEffect.preview.target) let rect = button.convert(button.bounds, to: preview.target.container) return UIPointerStyle(effect: .lift(preview), shape: .roundedRect(rect, radius: cornerRadius)) } ```",
      "sourceHash": "a635f3829671f9db7cb8a388774b8d921ca968740116d37f6828a0e2238b288c",
      "translatable": false,
      "preserveReason": "code",
      "contextBefore": "For example, the following code listing creates a pointer style that applies a lift effect to the button when the pointer hovers over it.",
      "contextAfter": "For more information, see [`Enhancing your iPad app with pointer interactions`](enhancing-your-ipad-app-with-pointer-interactions.md).",
      "documentTitle": "pointerStyleProvider",
      "framework": "UIKit",
      "ko": "```swift\nthreadColorButton.pointerStyleProvider = { button, proposedEffect, proposedShape -> UIPointerStyle? in\n    let cornerRadius: CGFloat = 4\n    let parameters = UIPreviewParameters()\n    let shapePath = UIBezierPath(roundedRect: button.bounds, cornerRadius: cornerRadius)\n    parameters.shadowPath = shapePath\n    let preview = UITargetedPreview(view: proposedEffect.preview.view, parameters: parameters, target: proposedEffect.preview.target)\n    \n    let rect = button.convert(button.bounds, to: preview.target.container)\n    return UIPointerStyle(effect: .lift(preview), shape: .roundedRect(rect, radius: cornerRadius))\n}\n```",
      "status": "preserved",
      "reviewed": false,
      "locked": true
    },
